# Supabase (Project Settings → API). Server-side only — never expose the service-role key.
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"
# Private Storage bucket for receipts (created by `npm run receipts:migrate` if missing)
SUPABASE_RECEIPTS_BUCKET="receipts"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-output-of: openssl rand -base64 32"
